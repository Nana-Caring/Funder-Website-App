{
  "info": {
    "name": "Payment Cards API - Complete Collection",
    "description": "Comprehensive test collection for the Payment Cards API with authentication and CRUD operations",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login (Get Auth Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set(\"AUTH_TOKEN\", response.token);",
                  "    console.log(\"Token saved:\", response.token);",
                  "    pm.test(\"Login successful\", function () {",
                  "        pm.expect(response.message).to.include(\"successful\");",
                  "    });",
                  "} else {",
                  "    pm.test(\"Login failed\", function () {",
                  "        pm.response.to.not.be.ok;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"funder@example.com\",\n  \"password\": \"your_password_here\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Payment Cards - Production Endpoints",
      "item": [
        {
          "name": "Add Standard Bank Visa (Production)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set(\"LAST_CARD_ID\", response.card.id);",
                  "    pm.test(\"Card added successfully\", function () {",
                  "        pm.expect(response.message).to.include(\"successfully\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{AUTH_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankName\": \"Standard Bank\",\n  \"cardNumber\": \"4111111111111111\",\n  \"expiryDate\": \"12/25\",\n  \"ccv\": \"123\",\n  \"nickname\": \"My Standard Bank Visa\",\n  \"isDefault\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/payment-cards/add",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "payment-cards", "add"]
            }
          }
        },
        {
          "name": "Get All Cards",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cards retrieved successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.test(\"Response has cards array\", function () {",
                  "        pm.expect(response.cards).to.be.an('array');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{AUTH_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/payment-cards/my-cards",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "payment-cards", "my-cards"]
            }
          }
        },
        {
          "name": "Set Default Card",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{AUTH_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/payment-cards/set-default/{{LAST_CARD_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "payment-cards", "set-default", "{{LAST_CARD_ID}}"]
            }
          }
        },
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{AUTH_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"cardId\": \"{{LAST_CARD_ID}}\",\n  \"description\": \"Test payment for account funding\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/payment-cards/create-payment-intent",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "payment-cards", "create-payment-intent"]
            }
          }
        },
        {
          "name": "Remove Card",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{AUTH_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/payment-cards/remove/{{LAST_CARD_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "payment-cards", "remove", "{{LAST_CARD_ID}}"]
            }
          }
        }
      ]
    },
